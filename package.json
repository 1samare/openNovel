{
  "name": "open-novel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地优先的小说 AI 辅助写作桌面应用",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "check:readmes": "node scripts/check-readmes.mjs",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "test:electron-smoke": "node scripts/electron-smoke.mjs",
    "test:acceptance": "npm run test:electron-smoke"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai-compatible": "^3.0.28",
    "@codemirror/commands": "6.10.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "ai": "^7.0.58",
    "docx": "9.7.1",
    "fflate": "0.8.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "glob": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "electron": "^43.1.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.11.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
